IDI_APP_ICON ICON "@CMAKE_CURRENT_SOURCE_DIR@/Assets/DualDeck.ico"

#include <winver.h>
1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS VS_FF_PRERELEASE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Alessandro Piermatteo\0"
            VALUE "FileDescription", "DualDeck soundboard (release candidate)\0"
            VALUE "FileVersion", "@DUALDECK_VERSION@\0"
            VALUE "ProductName", "DualDeck\0"
            VALUE "ProductVersion", "@DUALDECK_VERSION@\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Alessandro Piermatteo\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
